{
  "name": "ndis-lms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"node node_modules/vite/bin/vite.js\" \"cd server && npm run dev\"",
    "build": "node node_modules/vite/bin/vite.js build && cd server && npm install --include=dev && npm run build",
    "build:frontend": "node node_modules/vite/bin/vite.js build",
    "build:server": "cd server && npm install && npm run build",
    "start": "node server/dist/index.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "axios": "^1.6.2",
    "canvas-confetti": "^1.9.0",
    "date-fns": "^3.0.0",
    "framer-motion": "^10.16.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.5.2",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^6.19.0",
    "react-signature-canvas": "^1.1.0-alpha.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.0"
  }
}
