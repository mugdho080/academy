# ─── Database ───────────────────────────────────────────────────────────────
# Neon Postgres connection string
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXXX.neon.tech/academy_db?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
# Long random string — generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

# ─── AI ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Only needed for frontend Gemini calls (in browser)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Your Railway frontend URL or custom domain
FRONTEND_URL=https://academy.goodwillcare.com
